<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Reaching the providers' OAuth token endpoints. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Receiving the OAuth redirect on a loopback listener. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<!--
		Reading the folders the user typed into the File System source, and
		writing to them: Auto-organize moves their files into the folders the
		library says they belong in, which means creating folders and renaming
		files where they already live. Paths are entered as text rather than
		picked through an open panel, so the sandbox grants nothing on its own
		and every read and every move is refused without this.

		A temporary exception is what makes typed paths work at all; it is also
		what the App Store refuses, so shipping there means moving folder choice
		to NSOpenPanel and holding security-scoped bookmarks instead.
	-->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.temporary-exception.files.absolute-path.read-write</key>
	<array>
		<string>/</string>
	</array>
</dict>
</plist>
